# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=cparker
DB_SYNC=false
DB_LOGGING=false

# Redis Cache (Optional - will use in-memory if not configured)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300

# Blockchain RPC
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NETWORK=amoy

# Contracts (Your deployed contract addresses)
ORBIT_A_ADDRESS=0x...
ORBIT_B_ADDRESS=0x...
CCT_USDT_PAIR=0x606e0bF3FE428Ba65b8D363b75780c9E92750810

# Contract deployment transaction (optional - for accurate admin timestamp)
CONTRACT_DEPLOYMENT_TX=0x...

# Event Listener
ENABLE_EVENT_LISTENER=true

# Monitoring
LOG_LEVEL=info



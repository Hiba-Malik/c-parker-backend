# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=cparker
DB_SSL=false
DB_SYNC=false
DB_LOGGING=false

# Redis Cache (Optional - falls back to in-memory cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300

# Blockchain RPC (use Alchemy or Infura — avoid public endpoints that may fail in production)
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NETWORK=amoy

# Smart contracts (Polygon Amoy testnet)
ORBIT_A_ADDRESS=0x...
ORBIT_B_ADDRESS=0x...
CCT_USDT_PAIR=0x606e0bF3FE428Ba65b8D363b75780c9E92750810

# Contract deployment transaction (optional — used for accurate admin registration timestamp)
CONTRACT_DEPLOYMENT_TX=0x...

# Event listener (set false for API-only / portfolio deployments)
ENABLE_EVENT_LISTENER=true
START_BLOCK=latest

# Logging
LOG_LEVEL=info
